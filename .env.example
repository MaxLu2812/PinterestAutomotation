# Pinterest API (REQUIRED)
# Get these from https://developers.pinterest.com — see Gate 1 of ONBOARDING.md
PINTEREST_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# OpenAI (for GPT-4o-mini prompt refinement, OPTIONAL for V1)
# Passthrough mode works without it — prompts are generated from templates directly.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Hugging Face (for HF Inference API image generation fallback, OPTIONAL)
# Free tier works: https://huggingface.co/settings/tokens
HF_TOKEN=

# App config path (optional, defaults to ./config.yaml)
# PINTEREST_CONFIG=config.yaml
